{
  "name": "codefast",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./*.ts"
  },
  "scripts": {
    "bench": "turbo run bench --concurrency=1",
    "bench:fast": "turbo run bench:fast --concurrency=1",
    "bench:full": "turbo run bench:full --concurrency=1",
    "bench:isolate": "turbo run bench:isolate --concurrency=1",
    "bench:list": "turbo run bench:list --concurrency=1",
    "bench:report": "turbo run bench:report --concurrency=1",
    "bench:serve": "turbo run bench:serve",
    "bench:verbose": "turbo run bench:verbose --concurrency=1",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=@codefast*/*...",
    "check": "turbo run lint format:check check-types knip",
    "check-types": "turbo run check-types",
    "check:fix": "turbo run lint:fix && turbo run format",
    "clean": "turbo clean",
    "clean:cache": "pnpm store prune",
    "clean:modules": "pnpm -r exec rm -rf node_modules && rm -rf node_modules pnpm-lock.yaml",
    "cli:arrange": "pnpm run codefast arrange",
    "cli:arrange:inspect": "pnpm run codefast arrange inspect",
    "cli:arrange:preview": "pnpm run codefast arrange --dry-run",
    "cli:arrange:simplify": "pnpm run codefast arrange simplify",
    "cli:arrange:simplify:preview": "pnpm run codefast arrange simplify --dry-run",
    "cli:audit:comments": "pnpm run codefast audit comments",
    "cli:audit:display-names": "pnpm run codefast audit display-names",
    "cli:audit:imports": "pnpm run codefast audit imports",
    "cli:audit:links": "pnpm run codefast audit links",
    "cli:audit:rtl": "pnpm run codefast audit rtl",
    "cli:mirror": "pnpm run codefast mirror",
    "cli:mirror:preview": "pnpm run codefast mirror --dry-run",
    "codefast": "node ./packages/cli/dist/bin.js",
    "deps:install": "pnpm install && pnpm build:packages",
    "deps:outdated": "pnpm outdated --recursive",
    "deps:reinstall": "pnpm clean && pnpm clean:modules && pnpm install && pnpm build:packages",
    "deps:update": "pnpm update --latest --recursive",
    "deps:update:interactive": "pnpm dlx taze@latest latest --recursive --interactive --write --install && pnpm build:packages",
    "dev": "turbo run dev",
    "di:bench": "turbo run bench --filter=@benchmark/di",
    "di:bench:fast": "turbo run bench:fast --filter=@benchmark/di",
    "di:bench:full": "turbo run bench:full --filter=@benchmark/di",
    "di:bench:isolate": "turbo run bench:isolate --filter=@benchmark/di",
    "di:bench:list": "turbo run bench:list --filter=@benchmark/di",
    "di:bench:report": "turbo run bench:report --filter=@benchmark/di",
    "di:bench:serve": "turbo run bench:serve --filter=@benchmark/di",
    "di:bench:verbose": "turbo run bench:verbose --filter=@benchmark/di",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "prepare": "simple-git-hooks",
    "preview": "turbo run preview",
    "publish-packages": "pnpm run codefast pack-slim && changeset publish",
    "release": "changeset",
    "release:canary:enter": "changeset pre enter canary",
    "release:canary:exit": "changeset pre exit",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "test:integration": "turbo run test:integration",
    "test:type": "turbo run test:type",
    "test:unit": "turbo run test:unit",
    "test:watch": "turbo run test:watch",
    "tv:bench": "turbo run bench --filter=@benchmark/tailwind-variants",
    "tv:bench:fast": "turbo run bench:fast --filter=@benchmark/tailwind-variants",
    "tv:bench:full": "turbo run bench:full --filter=@benchmark/tailwind-variants",
    "tv:bench:isolate": "turbo run bench:isolate --filter=@benchmark/tailwind-variants",
    "tv:bench:list": "turbo run bench:list --filter=@benchmark/tailwind-variants",
    "tv:bench:report": "turbo run bench:report --filter=@benchmark/tailwind-variants",
    "tv:bench:serve": "turbo run bench:serve --filter=@benchmark/tailwind-variants",
    "tv:bench:verbose": "turbo run bench:verbose --filter=@benchmark/tailwind-variants",
    "verify": "pnpm build:packages && turbo run lint:fix && turbo run format && turbo run check-types test:coverage knip",
    "version-packages": "changeset version && pnpm run codefast tag",
    "web:build": "turbo run build --filter=@apps/web",
    "web:dev": "turbo run dev --filter=@apps/web",
    "web:preview": "turbo run preview --filter=@apps/web"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@codefast/cli": "workspace:*",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "simple-git-hooks": "catalog:",
    "turbo": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
