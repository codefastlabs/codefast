{
  "name": "@internal/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Builds the Codefast UI design-system artifact — tokens, brand book, live component previews — from @codefast/ui and the codefastlabs.com registry",
  "license": "MIT",
  "author": "Vuong Phan <mr.thevuong@gmail.com> (https://github.com/thevuong)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codefastlabs/codefast.git",
    "directory": "internal/design-system"
  },
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "design-system": "node --import tsx/esm src/main.ts"
  },
  "dependencies": {
    "@codefast/ui": "workspace:*",
    "@fontsource-variable/inter": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "jsdom": "catalog:",
    "lucide-react": "catalog:",
    "postcss": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@codefast/typescript-config": "workspace:*",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
