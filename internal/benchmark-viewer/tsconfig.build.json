{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["./tsconfig.json", "@codefast/typescript-config/library-build.json"],
  "compilerOptions": {
    "rootDir": "./src",
    // Opted out of the shared `isolatedDeclarations`: 49 sites in this browser app still infer
    // their exported types. See the tracked follow-up before flipping it on.
    "isolatedDeclarations": false
  },
  // Emit the whole src tree per-file for Node SSR; Vite then overwrites
  // dist/app/entry.js with the browser bundle.
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
