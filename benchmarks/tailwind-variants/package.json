{
  "name": "@benchmark/tailwind-variants",
  "version": "0.9.0",
  "private": true,
  "description": "Subprocess tinybench harness: @codefast/tailwind-variants vs tailwind-variants and vs class-variance-authority (pairwise reports)",
  "keywords": [
    "benchmark",
    "css",
    "performance",
    "tailwind",
    "tailwindcss",
    "utilities",
    "variants"
  ],
  "homepage": "https://github.com/codefastlabs/codefast/tree/main/benchmarks/tailwind-variants#readme",
  "bugs": {
    "url": "https://github.com/codefastlabs/codefast/issues"
  },
  "license": "MIT",
  "author": "Vuong Phan <mr.thevuong@gmail.com> (https://github.com/thevuong)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codefastlabs/codefast.git",
    "directory": "benchmarks/tailwind-variants"
  },
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "scripts": {
    "bench": "BENCH_ISOLATE=true node --import tsx/esm src/harness/run.ts",
    "bench:ab": "node --import tsx/esm src/harness/ab.ts",
    "bench:fast": "BENCH_MODE=fast node --import tsx/esm src/harness/run.ts",
    "bench:list": "node --import tsx/esm src/harness/list.ts",
    "bench:report": "node --import tsx/esm src/harness/report.ts",
    "bench:serve": "node --import tsx/esm src/harness/serve.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@codefast/tailwind-variants": "workspace:*",
    "@internal/benchmark-harness": "workspace:*",
    "@internal/benchmark-viewer": "workspace:*",
    "class-variance-authority": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwind-variants": "catalog:",
    "tsx": "catalog:"
  },
  "devDependencies": {
    "@codefast/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
