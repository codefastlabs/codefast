{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@codefast/typescript-config/library.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "types": ["node", "reflect-metadata"]
  },
  // The files this library owns, which tsx compiles in its decorator mode; the shared modules they import are
  // decorator-free and type-check here through those imports.
  "include": [
    "src/injection-js-benches.ts",
    "src/scenarios/collect-injection-js-scenarios.ts",
    "src/scenarios/injection-js/**/*.ts",
    "src/fixtures/injection-js-adapter.ts"
  ]
}
