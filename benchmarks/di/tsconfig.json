{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@codefast/typescript-config/library.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  // The editor default and the parent harness's runtime config; each child's program is checked under its own
  // `tsconfig.<library>.json`, whose decorator mode is the one that child runs with.
  "include": ["src"]
}
