{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@codefast/typescript-config/library.json",
  "compilerOptions": {
    "experimentalDecorators": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/iti-benches.ts",
    "src/harness/**/*.ts",
    "src/scenarios/types.ts",
    "src/scenarios/collect-iti-scenarios.ts",
    "src/scenarios/iti/**/*.ts",
