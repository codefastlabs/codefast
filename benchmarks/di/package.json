{
  "name": "@benchmark/di",
  "version": "0.10.1",
  "private": true,
  "description": "Head-to-head tinybench harness: @codefast/di vs InversifyJS v8 (full suite), Awilix, tsyringe, Brandi and ditox (core subset), plus injection-js (singleton-friendly rows)",
  "keywords": [
    "awilix",
    "benchmark",
    "brandi",
    "codefast",
    "dependency-injection",
    "ditox",
    "injection-js",
    "inversify",
    "tsyringe"
  ],
  "license": "MIT",
  "author": "Vuong Phan <mr.thevuong@gmail.com> (https://github.com/thevuong)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codefastlabs/codefast.git",
    "directory": "benchmarks/di"
  },
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "scripts": {
    "bench": "BENCH_ISOLATE=true node --import tsx/esm src/harness/run.ts",
    "bench:ab": "node --import tsx/esm src/harness/ab.ts",
    "bench:baseline": "BENCH_BASELINE=baselines BENCH_MODE=full BENCH_ISOLATE=true node --import tsx/esm src/harness/run.ts",
    "bench:fast": "BENCH_MODE=fast node --import tsx/esm src/harness/run.ts",
    "bench:list": "node --import tsx/esm src/harness/list.ts",
    "bench:report": "node --import tsx/esm src/harness/report.ts",
    "bench:serve": "node --import tsx/esm src/harness/serve.ts",
    "check-types": "tsc --noEmit",
    "instrument:alloc": "TSX_TSCONFIG_PATH=tsconfig.codefast.json node --import tsx/esm src/instruments/alloc.ts"
  },
  "dependencies": {
    "@codefast/di": "workspace:*",
    "@internal/benchmark-harness": "workspace:*",
    "@internal/benchmark-viewer": "workspace:*",
    "awilix": "catalog:",
    "brandi": "catalog:",
    "ditox": "catalog:",
    "injection-js": "catalog:",
    "inversify": "catalog:",
    "reflect-metadata": "catalog:",
    "tsx": "catalog:",
    "tsyringe": "catalog:"
  },
  "devDependencies": {
    "@codefast/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
