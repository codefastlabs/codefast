{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@codefast/typescript-config/library.json",
  "compilerOptions": {
    // `outDir` sits here, not only in tsconfig.build.json: knip derives its dist → src mapping from this file.
    "outDir": "./dist",
    "customConditions": ["source"],
    "lib": ["ES2024", "ESNext.Decorators"],
    "experimentalDecorators": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedSideEffectImports": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", ".turbo", "coverage"]
}
