{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["./tsconfig.json", "@codefast/typescript-config/library-build.json"],
  "compilerOptions": {
    "rootDir": "./src",
    // Opted out of the shared `isolatedDeclarations`: tsc 7.0.2 panics on this project with the
    // flag on ("Unhandled case in Node.Text: *ast.CallExpression") and is clean without it.
    "isolatedDeclarations": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
