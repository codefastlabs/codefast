{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["./tsconfig.json", "@codefast/typescript-config/library-build.json"],
  "compilerOptions": {
    "stableTypeOrdering": true,
    "erasableSyntaxOnly": true,
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
