{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["./tsconfig.json", "@codefast/typescript-config/library-build.json"],
  "compilerOptions": {
    "rootDir": "./src",
    // Also a library (see package.json exports): ships declarations for the programmatic entry.
    "declaration": true,
    "declarationMap": true,
    // Off — zod schemas here have types tsc emits by inference but cannot isolate.
    "isolatedDeclarations": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
