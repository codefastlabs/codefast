{
  "area": "tracker",
  "spec": "spec-tracker.md",
  "specVersion": "2.0.0",
  "vectors": [
    {
      "id": "tracker.consent-granted.all-receive",
      "source": "V1",
      "summary": "consent granted: every destination receives the envelope with the resolved id; the id callable is invoked once",
      "kind": "scenario",
      "given": {
        "destinations": ["required:D_req", "exempt:D_ex"],
        "anonymousId": "A",
        "consent": {
          "ads": true,
          "analytics": true
        }
      },
      "when": "track('signup', { plan: 'pro' })",
      "expect": {
        "received": {
          "D_req": 1,
          "D_ex": 1
        },
        "anonymousId": "A",
        "anonymousIdCallableInvocations": 1
      }
    },
    {
      "id": "tracker.consent-denied.exempt-only",
      "source": "V2",
      "summary": "consent denied: only exempt destinations receive, identifier-free; the id callable is never invoked",
      "kind": "scenario",
      "given": {
        "destinations": ["required:D_req", "exempt:D_ex"],
        "consent": {
          "ads": false,
          "analytics": false
        }
      },
      "when": "track('signup', { plan: 'pro' })",
      "expect": {
        "received": {
          "D_req": 0,
          "D_ex": 1
        },
        "anonymousId": "",
        "anonymousIdCallableInvocations": 0
      }
    },
    {
      "id": "tracker.consent-denied.no-exempt.short-circuit",
      "source": "V3",
      "summary": "consent denied with no exempt destinations: nothing is built or sent, no error, no id minted",
      "kind": "scenario",
      "given": {
        "destinations": ["required:D_req"],
        "consent": {
          "ads": false,
          "analytics": false
        }
      },
      "when": "track('signup', { plan: 'pro' })",
      "expect": {
        "received": {
          "D_req": 0
        },
        "envelopeBuilt": false,
        "anonymousIdCallableInvocations": 0,
        "error": false
      }
    },
    {
      "id": "tracker.mid-session.per-event-consent",
      "source": "V4",
      "summary": "consent is evaluated per event, so a mid-session change applies to the next event",
      "kind": "scenario",
      "given": {
        "destinations": ["required:D_req", "exempt:D_ex"],
        "consentSequence": [
          {
            "ads": false,
            "analytics": false
          },
          {
            "ads": true,
            "analytics": true
          }
        ]
      },
      "when": "track twice",
      "expect": {
        "firstEvent": "exempt-only-or-shortcircuit",
        "secondEvent": "all-receive",
        "constructionTimeCaching": false
      }
    },
    {
      "id": "tracker.delivery.failure-isolation",
      "source": "V5",
      "summary": "a destination that throws (sync) or rejects (async) does not break track() or starve other destinations",
      "kind": "scenario",
      "given": {
        "destinations": ["failing:D_req", "ok:D_ok"],
        "consent": {
          "ads": true,
          "analytics": true
        }
      },
      "when": "track('signup', { plan: 'pro' })",
      "expect": {
        "trackReturnedNormally": true,
        "received": {
          "D_ok": 1
        },
        "sameForAsyncRejection": true
      }
    },
    {
      "id": "tracker.errors.caller-bugs-propagate",
      "source": "V6",
      "summary": "validation failure and unknown-event are caller bugs and propagate; nothing is delivered",
      "kind": "scenario",
      "given": {
        "catalog": {
          "signup": "{ plan: string }"
        },
        "consent": {
          "ads": true,
          "analytics": true
        }
      },
      "when": "track('signup', { plan: 5 }) and track('nope', {})",
      "expect": {
        "bothRaise": true,
        "delivered": false
      }
    },
    {
      "id": "tracker.per-destination.purpose",
      "source": "V7",
      "summary": "each destination is gated on its own purpose: analytics does not open an ads sink, an analytics denial does not block it",
      "kind": "scenario",
      "given": {
        "destinations": ["required:D_req", "ads:D_ads", "exempt:D_ex"],
        "anonymousId": "A"
      },
      "when": "track('signup', { plan: 'pro' }) under each consent",
      "expect": {
        "analyticsOnly": {
          "consent": {
            "ads": false,
            "analytics": true
          },
          "received": {
            "D_req": 1,
            "D_ads": 0,
            "D_ex": 1
          },
          "anonymousId": "A"
        },
        "adsOnly": {
          "consent": {
            "ads": true,
            "analytics": false
          },
          "received": {
            "D_req": 0,
            "D_ads": 1,
            "D_ex": 1
          },
          "anonymousIdFor": {
            "D_ads": "A",
            "D_ex": ""
          },
          "anonymousIdCallableInvocations": 1,
          "sameEventId": true
        }
      }
    }
  ]
}
