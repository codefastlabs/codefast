# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Stack: pnpm workspaces + Turborepo. App: apps/ui (TanStack Start, Vite, Nitro).
# Libraries: native tsc (TypeScript 7) emit → dist/.

# ── Dependencies ──────────────────────────────────────────────────────────────────────────────────────────────────────
node_modules

# ── Environment ───────────────────────────────────────────────────────────────────────────────────────────────────────
.env
.env.*
*.local

# ── Build outputs ─────────────────────────────────────────────────────────────────────────────────────────────────────
.next/
out/
build
dist
dist-ssr
.swc/
tsconfig.tsbuildinfo
*.tsbuildinfo

# ── Framework & tool caches ───────────────────────────────────────────────────────────────────────────────────────────
.turbo
.vercel
.nitro
.tanstack
.wrangler
.output
.vinxi
.content-collections
vite.config.*.timestamp-*
.vite-hooks/
__unconfig*

# ── Testing & coverage ────────────────────────────────────────────────────────────────────────────────────────────────
coverage
.vitest
codecov
codecov.*
!codecov.yml

# ── Logs ──────────────────────────────────────────────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Editors & OS ──────────────────────────────────────────────────────────────────────────────────────────────────────
# JetBrains machine/user state — share via docs or .editorconfig instead.
.DS_Store
*.pem
.idea/

# ── Project tooling ───────────────────────────────────────────────────────────────────────────────────────────────────
storybook-static
build-storybook.log
.exports-analysis
.claude/worktrees/
benchmarks/**/bench-results/
count.txt
todos.json

# ── Python cache ──────────────────────────────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
