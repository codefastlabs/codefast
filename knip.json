{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["package.json", "codefast.config.js"],
      "ignoreBinaries": ["read"]
    },
    "benchmarks/di-inversify": {
      "entry": ["src/*-benches.ts"]
    },
    "internal/benchmark-harness": {
      "ignoreBinaries": ["tsx"]
    },
    "internal/benchmark-viewer": {
      "entry": ["src/app/entry.tsx"]
    },
    "packages/di": {
      "entry": ["examples/**/*.ts", "tests/integration/support/accessor-e2e.script.ts"],
      "ignoreDependencies": ["@babel/plugin-proposal-decorators"]
    },
    "packages/di-testing": {
      "ignoreDependencies": ["@babel/plugin-proposal-decorators"]
    }
  },
  "rules": {
    "optionalPeerDependencies": "off"
  }
}
