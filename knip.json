{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["package.json", "codefast.config.js"],
      "ignoreBinaries": ["read"]
    },
    "apps/web": {
      "entry": ["src/registry/**/usage.tsx", "src/features/home/demos/*.source.ts"],
      "ignoreDependencies": ["@babel/plugin-proposal-decorators"]
    },
    "benchmarks/di": {
      "entry": ["src/*-benches.ts"]
    },
    "benchmarks/tailwind-variants": {
      "entry": ["src/*-benches.ts"]
    },
    "internal/benchmark-harness": {
      "ignore": ["tests/integration/parent/fixtures/**"],
      "ignoreBinaries": ["bench"]
    },
    "internal/benchmark-viewer": {
      "entry": ["src/app/entry.tsx"]
    },
    "examples/tanstack-start": {
      "ignoreDependencies": ["@babel/plugin-proposal-decorators"]
    },
    "packages/di": {
      "entry": ["examples/**/*.ts", "tests/e2e/fixtures/**/entry-*.ts"],
      "ignoreDependencies": ["@babel/plugin-proposal-decorators"]
    },
    "packages/di-testing": {
      "ignoreDependencies": ["@babel/plugin-proposal-decorators"]
    }
  },
  "rules": {
    "optionalPeerDependencies": "off"
  }
}
